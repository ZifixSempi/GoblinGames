# BigWigs packager configuration
# https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File
#
# The repo holds several addon folders side by side. The packager first copies
# the whole repo into a folder named after `package-as`, then `move-folders`
# lifts each addon folder out to the top level of the zip, so players get:
#
#   GoblinGames/
#   GoblinGames_TicTacToe/
#   GoblinGames_Connect6/
#
# When you add a game module, add its folder here too.

package-as: GoblinGames

move-folders:
  GoblinGames/GoblinGames: GoblinGames
  GoblinGames/GoblinGames_TicTacToe: GoblinGames_TicTacToe
  GoblinGames/GoblinGames_Connect6: GoblinGames_Connect6

# Libraries are committed under GoblinGames/Libs, so no externals are needed.

ignore:
  - docs
  - tools
  - README.md

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

enable-nolib-creation: no
